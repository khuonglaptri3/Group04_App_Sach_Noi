<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_close"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:backgroundTint="#E2E8F0"
                    app:icon="@drawable/ic_close"
                    app:iconTint="?attr/colorOnSurface" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="90dp"
                    android:layout_height="135dp"
                    android:layout_centerHorizontal="true"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/iv_book_cover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/bacl" />
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>

            <TextView
                android:id="@+id/tv_review_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Đánh giá Ebook" />

            <RatingBar
                android:id="@+id/rb_review"
                style="@style/Widget.AppCompat.RatingBar.Indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:isIndicator="false"
                android:numStars="5"
                android:rating="0"
                android:stepSize="1"
                android:progressTint="#94A3B8"
                android:secondaryProgressTint="#94A3B8"
                android:progressBackgroundTint="#E2E8F0" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:singleLine="false"
                android:gravity="center">

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Câu chuyện hay"
                    android:textColor="#64748B"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#CBD5E1"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giao diện đẹp"
                    android:textColor="#64748B"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#CBD5E1"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bài học giá trị"
                    android:textColor="#64748B"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#CBD5E1"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tiện lợi"
                    android:textColor="#64748B"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="#CBD5E1"
                    app:checkedIconVisible="false" />
            </com.google.android.material.chip.ChipGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="#E2E8F0" />

            <EditText
                android:id="@+id/et_comment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@null"
                android:hint="Bấm để viết đánh giá..."
                android:textColorHint="#94A3B8"
                android:textColor="?attr/colorOnSurface"
                android:minLines="5"
                android:gravity="top|start"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Gửi đánh giá"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:enabled="false"
                app:cornerRadius="28dp"
                app:backgroundTint="#E2E8F0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Lưu ý khi đánh giá"
                android:textColor="#D97706"
                android:textSize="14sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
