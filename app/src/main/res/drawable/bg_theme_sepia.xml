<!-- res/drawable/bg_theme_sepia.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- A classic light sepia/parchment hex color -->
    <solid android:color="#F4ECD8" />

    <!-- Optional: Add slightly rounded corners -->
    <corners android:radius="8dp" />

    <!-- Optional: Add a slightly darker border -->
    <stroke
        android:width="1dp"
        android:color="#D5C5A3" />
</shape>