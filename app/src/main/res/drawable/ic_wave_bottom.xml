<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_wave_bottom.xml
    A wave/curved shape that creates the smooth transition from coral to white.
    This renders as a white wave sitting on top of the coral background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="393dp"
    android:height="80dp"
    android:viewportWidth="393"
    android:viewportHeight="80">

    <!-- White wave path — fills from the curve down to the bottom -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M0,40
            C80,0 160,70 240,30
            C300,5 340,55 393,20
            L393,80
            L0,80
            Z
        " />
</vector>
